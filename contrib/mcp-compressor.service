# MCP Compressor backend-pool daemon as a systemd user service.
#
# Install (per user):
#   mkdir -p ~/.config/systemd/user
#   cp contrib/mcp-compressor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now mcp-compressor.service
#
# After this, any MCP client config invoking `mcp-compressor` without
# `--server` (i.e. the default client-mode wrapping pattern) will find
# the pool at 127.0.0.1:9020 and connect successfully. Without the
# daemon, client-mode invocations fail with `httpx.ConnectError: All
# connection attempts failed` and the MCP host (Claude Code, Cursor,
# Continue, ...) reports "Failed to connect to <server-name>".

[Unit]
Description=MCP Compressor backend pool
After=network-online.target

[Service]
Type=simple
# The default `uv tool install mcp-compressor` / `pipx install mcp-compressor`
# layout puts the launcher at ~/.local/bin/mcp-compressor. PATH is set so
# the wrapped MCP servers (forgejo-mcp, zulip-mcp, ...) are reachable too.
Environment=PATH=%h/.local/bin:%h/go/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/mcp-compressor --server --server-port 9020
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
