# MCP Compressor daemon as a systemd user service.
#
# Install (per user):
#   mkdir -p ~/.config/systemd/user
#   cp contrib/mcp-compressor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now mcp-compressor.service
#
# mcp-compressor is one service per user. It fronts the estate — every server
# in your MCP configuration — behind four tools at http://127.0.0.1:9020/mcp.
# MCP clients connect to that URL over streamable HTTP; they do not launch
# mcp-compressor themselves. Point your client's MCP config at
# { "type": "http", "url": "http://127.0.0.1:9020/mcp" }.

[Unit]
Description=MCP Compressor estate daemon
After=network-online.target

[Service]
Type=simple
# The default `uv tool install mcp-compressor` / `pipx install mcp-compressor`
# layout puts the launcher at ~/.local/bin/mcp-compressor. PATH is set so the
# estate's backend servers (forgejo-mcp, zulip-mcp, ...) are reachable too.
Environment=PATH=%h/.local/bin:%h/go/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/mcp-compressor --server --server-port 9020
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
